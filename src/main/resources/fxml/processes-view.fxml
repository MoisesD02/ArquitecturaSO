<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.simuladorso.ui.controllers.ProcessesController"
      spacing="14"
      styleClass="content-container">

    <!-- ENCABEZADO -->
    <VBox spacing="3">
        <Label text="Gestión de Procesos" styleClass="page-title"/>
    </VBox>

    <Separator/>

    <!-- SELECTOR DEL ALGORITMO -->
    <HBox alignment="CENTER_LEFT"
          spacing="12"
          styleClass="card, compact-card">

        <Label text="Algoritmo de planificación"
               styleClass="card-title"/>

        <ComboBox fx:id="cmbAlgorithm"
                  prefWidth="270"/>

        <Region HBox.hgrow="ALWAYS"/>

        <!-- Solo aparecerá en Round Robin -->
        <HBox fx:id="quantumContainer"
              alignment="CENTER_LEFT"
              spacing="8"
              visible="false"
              managed="false">

            <Label text="Quantum"
                   styleClass="muted"/>

            <TextField fx:id="txtQuantum"
                       promptText="2"
                       prefWidth="75"/>

        </HBox>

    </HBox>

    <!-- FORMULARIO + TABLA -->
    <HBox spacing="14"
          prefHeight="285"
          minHeight="285"
          maxHeight="285">

        <!-- FORMULARIO -->
        <VBox prefWidth="285"
              minWidth="265"
              spacing="10"
              styleClass="card">

            <Label text="NUEVO PROCESO"
                   styleClass="card-title"/>

            <Label text="Nombre"
                   styleClass="muted"/>

            <TextField fx:id="txtProcessName"
                       promptText="Ej. Proceso 1"/>

            <HBox spacing="10">

                <VBox spacing="5"
                      HBox.hgrow="ALWAYS">

                    <Label text="Tiempo de llegada"
                           styleClass="muted"/>

                    <TextField fx:id="txtArrivalTime"
                               promptText="0"/>

                </VBox>

                <VBox spacing="5"
                      HBox.hgrow="ALWAYS">

                    <Label text="Ráfaga CPU"
                           styleClass="muted"/>

                    <TextField fx:id="txtBurstTime"
                               promptText="5"/>

                </VBox>

            </HBox>

            <!-- CAMPO DINÁMICO: PRIORIDAD -->
            <VBox fx:id="priorityContainer"
                  spacing="5"
                  visible="false"
                  managed="false">

                <Label text="Prioridad"
                       styleClass="muted"/>

                <ComboBox fx:id="cmbPriority"
                          maxWidth="Infinity"/>

            </VBox>

            <!-- CAMPO DINÁMICO: COLA -->
            <VBox fx:id="queueContainer"
                  spacing="5"
                  visible="false"
                  managed="false">

                <Label text="Cola"
                       styleClass="muted"/>

                <ComboBox fx:id="cmbQueue"
                          maxWidth="Infinity"/>

            </VBox>

            <!-- CAMPO DINÁMICO: MEMORIA -->
            <VBox fx:id="memoryContainer"
                  spacing="5"
                  visible="false"
                  managed="false">

                <Label text="Memoria requerida (MB)"
                       styleClass="muted"/>

                <TextField fx:id="txtMemory"
                           promptText="128"/>

            </VBox>

            <Label fx:id="lblFormMessage"
                   text=""
                   wrapText="true"
                   styleClass="form-message"/>

            <Region VBox.vgrow="ALWAYS"/>

            <Button text="+  Agregar proceso"
                    onAction="#handleAddProcess"
                    maxWidth="Infinity"
                    styleClass="button-primary"/>

        </VBox>


        <!-- TABLA DE PROCESOS -->
        <VBox spacing="10"
              styleClass="card"
              HBox.hgrow="ALWAYS">

            <Label text="PROCESOS"
                   styleClass="card-title"/>

            <TableView fx:id="tblProcesses"
                       VBox.vgrow="ALWAYS">

                <columns>

                    <TableColumn fx:id="colPid"
                                 text="PID"/>

                    <TableColumn fx:id="colName"
                                 text="Nombre"/>

                    <TableColumn fx:id="colArrival"
                                 text="Llegada"/>

                    <TableColumn fx:id="colBurst"
                                 text="Ráfaga"/>

                    <TableColumn fx:id="colRemaining"
                                 text="Restante"
                                 visible="false"/>

                    <TableColumn fx:id="colPriority"
                                 text="Prioridad"
                                 visible="false"/>

                    <TableColumn fx:id="colQueue"
                                 text="Cola"
                                 visible="false"/>

                    <TableColumn fx:id="colMemory"
                                 text="Memoria"
                                 visible="false"/>

                    <TableColumn fx:id="colState"
                                 text="Estado"/>

                </columns>

            </TableView>

        </VBox>

    </HBox>


    <!-- COLA DE LISTOS -->
    <VBox spacing="9"
          styleClass="card, compact-card">

        <Label text="COLA DE LISTOS"
               styleClass="card-title"/>

        <HBox fx:id="readyQueueContainer"
              alignment="CENTER_LEFT"
              spacing="8"
              minHeight="42"/>

    </VBox>


    <!-- BOTONES DE CONTROL -->
    <HBox alignment="CENTER_LEFT"
          spacing="10">

        <Button text="Cargar ejemplo"
                onAction="#handleLoadExample"
                styleClass="button-secondary"/>

        <!-- Los habilitaremos cuando implementemos FCFS -->
        <Button fx:id="btnExecute"
                text="▶  Ejecutar"
                onAction="#handleExecute"
                disable="true"
                styleClass="button-success"/>

        <Button fx:id="btnStep"
                text="▶|  Paso"
                onAction="#handleStep"
                disable="true"
                styleClass="button-secondary"/>

        <Button text="↻  Reiniciar"
                onAction="#handleReset"
                styleClass="button-primary"/>

    </HBox>


    <!-- CPU + GANTT -->
    <HBox spacing="14">

        <!-- CPU -->
        <VBox prefWidth="275"
              spacing="9"
              styleClass="card">

            <Label text="CPU"
                   styleClass="card-title"/>

            <HBox spacing="7">

                <Label text="Tiempo:"
                       styleClass="muted"/>

                <Label fx:id="lblSimulationTime"
                       text="0"
                       styleClass="value"/>

            </HBox>

            <HBox spacing="7">
                <Label text="Estado:"
                       styleClass="muted"/>

                <Label fx:id="lblCpuState"
                       text="LIBRE"
                       styleClass="value"/>
            </HBox>

            <HBox spacing="7">
                <Label text="Proceso:"
                       styleClass="muted"/>

                <Label fx:id="lblCurrentProcess"
                       text="---"
                       styleClass="value"/>
            </HBox>

            <HBox spacing="7">
                <Label text="Tiempo restante:"
                       styleClass="muted"/>

                <Label fx:id="lblRemainingTime"
                       text="---"
                       styleClass="value"/>
            </HBox>

            <ProgressBar fx:id="cpuProgress"
                         progress="0"
                         maxWidth="Infinity"/>

        </VBox>


        <!-- GANTT -->
        <VBox spacing="9"
              styleClass="card"
              HBox.hgrow="ALWAYS">

            <Label text="DIAGRAMA DE GANTT"
                   styleClass="card-title"/>

            <HBox fx:id="ganttContainer"
                  alignment="CENTER_LEFT"
                  spacing="0"
                  minHeight="82">

                <Label fx:id="lblGanttEmpty"
                       text="Esperando ejecución..."
                       styleClass="muted"/>

            </HBox>

        </VBox>

    </HBox>


    <!-- RESULTADOS -->
    <VBox spacing="9"
          styleClass="card, compact-card">

        <Label text="RESULTADOS"
               styleClass="card-title"/>

        <HBox spacing="32">

            <HBox spacing="7">
                <Label text="Espera promedio:"
                       styleClass="muted"/>

                <Label fx:id="lblAverageWait"
                       text="--"
                       styleClass="value"/>
            </HBox>

            <HBox spacing="7">
                <Label text="Respuesta promedio:"
                       styleClass="muted"/>

                <Label fx:id="lblAverageResponse"
                       text="--"
                       styleClass="value"/>
            </HBox>

            <HBox spacing="7">
                <Label text="Tiempo de ejecución:"
                       styleClass="muted"/>

                <Label fx:id="lblExecutionTime"
                       text="--"
                       styleClass="value"/>
            </HBox>

        </HBox>

    </VBox>

</VBox>