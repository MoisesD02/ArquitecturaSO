<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.simuladorso.ui.controllers.memory.virtualmemory.LruController"
      spacing="12"
      alignment="TOP_CENTER"
      styleClass="card"
      maxWidth="Infinity"
      VBox.vgrow="ALWAYS">

    <padding>
        <Insets top="12"
                right="20"
                bottom="16"
                left="20"/>
    </padding>


    <!-- MENSAJE -->

    <HBox alignment="CENTER_RIGHT"
          maxWidth="Infinity">

        <Label fx:id="lblMensaje"
               style="-fx-font-size: 13px;
                      -fx-font-weight: bold;
                      -fx-text-fill: #315da8;"/>

    </HBox>


    <!-- CONFIGURACIÓN -->

    <VBox spacing="10"
          maxWidth="Infinity"
          styleClass="card, compact-card">

        <VBox spacing="3">

            <Label text="Configuración de la simulación"
                   styleClass="card-title"
                   style="-fx-font-size: 14px;"/>

            <Label text="LRU reemplaza la página cuya última utilización ocurrió hace más tiempo."
                   styleClass="muted"
                   wrapText="true"/>

        </VBox>


        <HBox spacing="14"
              alignment="BOTTOM_LEFT"
              maxWidth="Infinity">


            <!-- REFERENCIAS -->

            <VBox spacing="4"
                  HBox.hgrow="ALWAYS">

                <Label text="Cadena de referencias"
                       styleClass="muted"/>

                <TextField fx:id="txtReferencias"
                           text="2,3,2,1,5,2,4,5,3,2,5,2"
                           promptText="Ej. 2,3,2,1,5,2,4,5,3,2,5,2"
                           prefHeight="34"/>

            </VBox>


            <!-- MARCOS -->

            <VBox spacing="4"
                  minWidth="120"
                  prefWidth="130">

                <Label text="Cantidad de marcos"
                       styleClass="muted"/>

                <TextField fx:id="txtMarcos"
                           text="3"
                           promptText="3"
                           prefHeight="34"/>

            </VBox>


            <!-- BOTONES -->

            <Button text="Simular LRU"
                    onAction="#handleSimular"
                    prefHeight="34"
                    styleClass="button-primary"/>


            <Button text="Cargar ejemplo"
                    onAction="#handleEjemplo"
                    prefHeight="34"
                    styleClass="button-secondary"/>

        </HBox>

    </VBox>


    <!-- MÉTRICAS -->

    <HBox spacing="12"
          alignment="CENTER"
          maxWidth="Infinity">


        <VBox spacing="2"
              alignment="CENTER"
              HBox.hgrow="ALWAYS"
              prefHeight="55"
              styleClass="card">

            <Label text="REFERENCIAS"
                   styleClass="muted"
                   style="-fx-font-size: 11px;"/>

            <Label fx:id="lblTotalReferencias"
                   text="0"
                   styleClass="value"
                   style="-fx-font-size: 20px;"/>

        </VBox>


        <VBox spacing="2"
              alignment="CENTER"
              HBox.hgrow="ALWAYS"
              prefHeight="55"
              styleClass="card">

            <Label text="FALLOS DE PÁGINA"
                   styleClass="muted"
                   style="-fx-font-size: 11px;"/>

            <Label fx:id="lblFallos"
                   text="0"
                   styleClass="value"
                   style="-fx-font-size: 20px;
                          -fx-text-fill: #dc2626;"/>

        </VBox>


        <VBox spacing="2"
              alignment="CENTER"
              HBox.hgrow="ALWAYS"
              prefHeight="55"
              styleClass="card">

            <Label text="ACIERTOS"
                   styleClass="muted"
                   style="-fx-font-size: 11px;"/>

            <Label fx:id="lblAciertos"
                   text="0"
                   styleClass="value"
                   style="-fx-font-size: 20px;
                          -fx-text-fill: #16a34a;"/>

        </VBox>

    </HBox>

    <VBox spacing="6"
          maxWidth="Infinity"
          styleClass="card">

        <Label text="Resultados"
               styleClass="card-title"/>

        <HBox spacing="12"
              alignment="CENTER_LEFT">

            <Label text="Cantidad de Fallos:"
                   styleClass="muted"/>

            <Label fx:id="lblCantidadFallos"
                   text="0"
                   style="-fx-font-weight: bold;
                      -fx-font-size: 14px;
                      -fx-text-fill: #142744;"/>

            <Region HBox.hgrow="ALWAYS"/>

            <Label text="Frecuencia:"
                   styleClass="muted"/>

            <Label fx:id="lblFrecuencia"
                   text="0.00"
                   style="-fx-font-weight: bold;
                      -fx-font-size: 14px;
                      -fx-text-fill: #142744;"/>

            <Region HBox.hgrow="ALWAYS"/>

            <Label text="Rendimiento:"
                   styleClass="muted"/>

            <Label fx:id="lblRendimiento"
                   text="100.00%"
                   style="-fx-font-weight: bold;
                      -fx-font-size: 14px;
                      -fx-text-fill: #142744;"/>

        </HBox>

    </VBox>

    <!-- SIMULACIÓN -->

    <VBox spacing="8"
          maxWidth="Infinity"
          VBox.vgrow="ALWAYS"
          styleClass="card">

        <HBox alignment="CENTER_LEFT"
              spacing="10">

            <VBox spacing="2">

                <Label text="Simulación paso a paso"
                       styleClass="card-title"/>

                <Label text="Cada columna muestra el estado de memoria después de procesar una referencia."
                       styleClass="muted"/>

            </VBox>


            <Region HBox.hgrow="ALWAYS"/>


            <Button text="Limpiar"
                    onAction="#handleLimpiar"
                    prefWidth="90"
                    prefHeight="28"
                    styleClass="button-secondary"/>

        </HBox>


        <ScrollPane fitToWidth="true"
                    fitToHeight="true"
                    hbarPolicy="AS_NEEDED"
                    vbarPolicy="NEVER"
                    maxWidth="Infinity"
                    VBox.vgrow="ALWAYS"
                    styleClass="gantt-scroll">

            <content>

                <VBox fx:id="contenedorSimulacion"
                      spacing="0"
                      alignment="TOP_LEFT"
                      maxWidth="Infinity"
                      VBox.vgrow="ALWAYS"/>

            </content>

        </ScrollPane>

    </VBox>

</VBox>