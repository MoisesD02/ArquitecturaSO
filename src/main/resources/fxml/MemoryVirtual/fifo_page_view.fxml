<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.simuladorso.ui.controllers.memory.virtualmemory.FifoController"
      spacing="16"
      alignment="TOP_CENTER"
      style="-fx-background-color: #f3f6fa;">

    <padding>
        <Insets top="22"
                right="28"
                bottom="22"
                left="28"/>
    </padding>


    <!-- ENCABEZADO -->

    <HBox alignment="CENTER_LEFT"
          spacing="15"
          maxWidth="1000">

        <VBox spacing="4">

            <Label text="FIFO - Primero en Entrar, Primero en Salir"
                   style="-fx-font-size: 22px;
                          -fx-font-weight: bold;
                          -fx-text-fill: #102541;"/>

            <Label text="Reemplaza la página que lleva más tiempo cargada en memoria."
                   style="-fx-font-size: 13px;
                          -fx-text-fill: #6d7f9c;"/>

        </VBox>

        <Region HBox.hgrow="ALWAYS"/>

        <Label fx:id="lblMensaje"
               style="-fx-font-size: 12px;
                      -fx-font-weight: bold;
                      -fx-text-fill: #315da8;"/>

    </HBox>


    <Separator maxWidth="1000"/>


    <!-- CONFIGURACIÓN -->

    <VBox spacing="12"
          maxWidth="1000"
          style="-fx-background-color: white;
                 -fx-background-radius: 12;
                 -fx-border-color: #d6dfeb;
                 -fx-border-radius: 12;
                 -fx-padding: 18;">

        <Label text="Configuración de la simulación"
               style="-fx-font-size: 15px;
                      -fx-font-weight: bold;
                      -fx-text-fill: #142744;"/>

        <HBox spacing="18"
              alignment="BOTTOM_LEFT">

            <VBox spacing="6"
                  HBox.hgrow="ALWAYS">

                <Label text="Cadena de referencias"
                       style="-fx-font-size: 12px;
                              -fx-text-fill: #60718e;"/>

                <TextField fx:id="txtReferencias"
                           text="2,3,2,1,5,2,4,5,3,2,5,2"
                           promptText="Ejemplo: 2,3,2,1,5,2,4,5,3,2,5,2"
                           prefHeight="38"
                           style="-fx-background-radius: 7;
                                  -fx-border-radius: 7;"/>

            </VBox>


            <VBox spacing="6">

                <Label text="Cantidad de marcos"
                       style="-fx-font-size: 12px;
                              -fx-text-fill: #60718e;"/>

                <TextField fx:id="txtMarcos"
                           text="3"
                           promptText="3"
                           prefWidth="130"
                           prefHeight="38"
                           style="-fx-background-radius: 7;
                                  -fx-border-radius: 7;"/>

            </VBox>


            <Button text="Simular FIFO"
                    onAction="#handleSimular"
                    prefWidth="145"
                    prefHeight="38"
                    style="-fx-background-color: #3968ee;
                           -fx-background-radius: 7;
                           -fx-text-fill: white;
                           -fx-font-weight: bold;
                           -fx-cursor: hand;"/>


            <Button text="Cargar ejemplo"
                    onAction="#handleEjemplo"
                    prefWidth="135"
                    prefHeight="38"
                    style="-fx-background-color: #647a9c;
                           -fx-background-radius: 7;
                           -fx-text-fill: white;
                           -fx-font-weight: bold;
                           -fx-cursor: hand;"/>

        </HBox>

    </VBox>


    <!-- RESUMEN -->

    <HBox spacing="14"
          alignment="CENTER"
          maxWidth="1000">

        <VBox spacing="5"
              alignment="CENTER"
              HBox.hgrow="ALWAYS"
              prefHeight="80"
              style="-fx-background-color: white;
                     -fx-background-radius: 10;
                     -fx-border-color: #d6dfeb;
                     -fx-border-radius: 10;">

            <Label text="REFERENCIAS"
                   style="-fx-font-size: 11px;
                          -fx-text-fill: #7485a1;"/>

            <Label fx:id="lblTotalReferencias"
                   text="0"
                   style="-fx-font-size: 23px;
                          -fx-font-weight: bold;
                          -fx-text-fill: #142744;"/>

        </VBox>


        <VBox spacing="5"
              alignment="CENTER"
              HBox.hgrow="ALWAYS"
              prefHeight="80"
              style="-fx-background-color: white;
                     -fx-background-radius: 10;
                     -fx-border-color: #d6dfeb;
                     -fx-border-radius: 10;">

            <Label text="FALLOS DE PÁGINA"
                   style="-fx-font-size: 11px;
                          -fx-text-fill: #7485a1;"/>

            <Label fx:id="lblFallos"
                   text="0"
                   style="-fx-font-size: 23px;
                          -fx-font-weight: bold;
                          -fx-text-fill: #142744;"/>

        </VBox>


        <VBox spacing="5"
              alignment="CENTER"
              HBox.hgrow="ALWAYS"
              prefHeight="80"
              style="-fx-background-color: white;
                     -fx-background-radius: 10;
                     -fx-border-color: #d6dfeb;
                     -fx-border-radius: 10;">

            <Label text="ACIERTOS"
                   style="-fx-font-size: 11px;
                          -fx-text-fill: #7485a1;"/>

            <Label fx:id="lblAciertos"
                   text="0"
                   style="-fx-font-size: 23px;
                          -fx-font-weight: bold;
                          -fx-text-fill: #142744;"/>

        </VBox>

    </HBox>


    <!-- SIMULACIÓN -->

    <VBox spacing="12"
          maxWidth="1000"
          prefHeight="420"
          minHeight="420"
          style="-fx-background-color: white;
                 -fx-background-radius: 12;
                 -fx-border-color: #d6dfeb;
                 -fx-border-radius: 12;
                 -fx-padding: 18;">

        <HBox alignment="CENTER_LEFT"
              spacing="10">

            <VBox spacing="3">

                <Label text="Simulación paso a paso"
                       style="-fx-font-size: 16px;
                              -fx-font-weight: bold;
                              -fx-text-fill: #142744;"/>

                <Label text="Cada columna representa una referencia procesada por FIFO."
                       style="-fx-font-size: 12px;
                              -fx-text-fill: #7485a1;"/>

            </VBox>

            <Region HBox.hgrow="ALWAYS"/>

            <Button text="Limpiar"
                    onAction="#handleLimpiar"
                    prefWidth="100"
                    style="-fx-background-color: #647a9c;
                           -fx-background-radius: 7;
                           -fx-text-fill: white;
                           -fx-font-weight: bold;
                           -fx-cursor: hand;"/>

        </HBox>


        <ScrollPane fitToWidth="false"
                    fitToHeight="false"
                    hbarPolicy="AS_NEEDED"
                    vbarPolicy="AS_NEEDED"
                    prefHeight="320"
                    minHeight="320"
                    style="-fx-background-color: transparent;
                           -fx-background: transparent;">

            <content>

                <VBox fx:id="contenedorSimulacion"
                      spacing="8"
                      alignment="TOP_LEFT">

                    <padding>
                        <Insets top="10"
                                right="10"
                                bottom="10"
                                left="10"/>
                    </padding>

                </VBox>

            </content>

        </ScrollPane>

    </VBox>

</VBox>