<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<ScrollPane fitToWidth="true" fitToHeight="true" styleClass="dashboard-scroll"
            xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.simuladorso.ui.controllers.files.FilesController">

    <content>
        <VBox spacing="16" styleClass="card">
            <padding><Insets top="16" right="20" bottom="16" left="20"/></padding>

            <HBox alignment="CENTER_LEFT" spacing="12">
                <VBox spacing="2" HBox.hgrow="ALWAYS">
                    <Label text="Sistema de Archivos — Asignación por I-Nodos" styleClass="card-title" style="-fx-font-size: 20px;"/>
                    <Label text="Archivos físicos (.txt) vinculados a bloques virtuales indexados." styleClass="muted"/>
                </VBox>
                <Label fx:id="lblEspacioLibre" text="Bloques Libres: 20 / 20" styleClass="status-on" style="-fx-font-size: 14px; -fx-padding: 6 12;"/>
            </HBox>

            <HBox spacing="10" alignment="CENTER_LEFT" styleClass="card" style="-fx-background-color: rgba(255,255,255,0.03);">
                <TextField fx:id="txtNombre" promptText="Nombre del archivo" prefWidth="200"/>
                <Spinner fx:id="spnBloques" initialValue="1" min="1" max="20" prefWidth="90"/>
                <Button text="+ Crear Archivo" onAction="#handleCrearArchivo" styleClass="button-success"/>
                <Button text="🗑 Eliminar Seleccionado" onAction="#handleEliminarArchivo" styleClass="button-danger"/>
            </HBox>

            <VBox spacing="8" styleClass="card">
                <Label text="ESTADO FÍSICO DEL DISCO (20 BLOQUES)" styleClass="card-title"/>
                <FlowPane fx:id="gridDisco" hgap="8" vgap="8" alignment="CENTER_LEFT"/>
            </VBox>

            <!-- CONTENEDOR DIVIDIDO: TABLA (IZQUIERDA) Y METADATOS (DERECHA) -->
            <HBox spacing="16" VBox.vgrow="ALWAYS">

                <!-- Mitad Izquierda: Tabla -->
                <VBox spacing="8" HBox.hgrow="ALWAYS" styleClass="card">
                    <Label text="REGISTRO DE CONTROL (I-NODOS)" styleClass="card-title"/>
                    <TableView fx:id="tblINodos" VBox.vgrow="ALWAYS" prefHeight="220">
                        <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
                        <columns>
                            <TableColumn fx:id="colId" text="I-Nodo"/>
                            <TableColumn fx:id="colNombre" text="Archivo"/>
                            <TableColumn fx:id="colTamano" text="Peso (Bloques)"/>
                        </columns>
                    </TableView>
                </VBox>

                <!-- Mitad Derecha: Metadatos -->
                <VBox spacing="10" prefWidth="350" styleClass="card" style="-fx-background-color: rgba(0,0,0,0.1);">
                    <Label text="METADATOS DEL ARCHIVO" styleClass="card-title"/>
                    <GridPane hgap="10" vgap="12">
                        <Label text="ID I-Nodo:" GridPane.rowIndex="0" GridPane.columnIndex="0" styleClass="muted"/>
                        <Label fx:id="lblMetaId" text="-" GridPane.rowIndex="0" GridPane.columnIndex="1" styleClass="value"/>

                        <Label text="Nombre:" GridPane.rowIndex="1" GridPane.columnIndex="0" styleClass="muted"/>
                        <Label fx:id="lblMetaNombre" text="-" GridPane.rowIndex="1" GridPane.columnIndex="1" styleClass="value"/>

                        <Label text="Creación:" GridPane.rowIndex="2" GridPane.columnIndex="0" styleClass="muted"/>
                        <Label fx:id="lblMetaFecha" text="-" GridPane.rowIndex="2" GridPane.columnIndex="1" styleClass="value"/>

                        <Label text="Bloques Ref:" GridPane.rowIndex="3" GridPane.columnIndex="0" styleClass="muted"/>
                        <Label fx:id="lblMetaBloques" text="-" GridPane.rowIndex="3" GridPane.columnIndex="1" styleClass="value" wrapText="true"/>

                        <Label text="Propietario:" GridPane.rowIndex="4" GridPane.columnIndex="0" styleClass="muted"/>
                        <Label fx:id="lblMetaProp" text="-" GridPane.rowIndex="4" GridPane.columnIndex="1" styleClass="value"/>

                        <Label text="Permisos:" GridPane.rowIndex="5" GridPane.columnIndex="0" styleClass="muted"/>
                        <Label fx:id="lblMetaPerm" text="-" GridPane.rowIndex="5" GridPane.columnIndex="1" styleClass="value"/>
                    </GridPane>

                    <Label text="Ruta Física en Disco:" styleClass="muted" style="-fx-padding: 10 0 0 0;"/>
                    <TextArea fx:id="txtMetaRuta" editable="false" prefRowCount="2" wrapText="true" style="-fx-font-size: 11px;"/>
                </VBox>
            </HBox>

        </VBox>
    </content>
</ScrollPane>