<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<ScrollPane fitToWidth="true"
            fitToHeight="true"
            hbarPolicy="NEVER"
            vbarPolicy="AS_NEEDED"
            styleClass="gantt-scroll"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.simuladorso.ui.controllers.memory.multiprogramming.BuddySystemController">

    <content>
        <VBox spacing="12" alignment="TOP_CENTER" styleClass="card" maxWidth="Infinity">
            <padding>
                <Insets top="12" right="20" bottom="16" left="20"/>
            </padding>

            <!-- BARRA DE CONFIGURACIÓN SUPERIOR -->
            <HBox spacing="15" alignment="CENTER_LEFT" styleClass="card, compact-card" maxWidth="Infinity">
                <HBox spacing="8" alignment="CENTER_LEFT">
                    <Label text="Memoria Total (KB):" styleClass="muted"/>
                    <TextField fx:id="txtTotalMemory" text="1024" promptText="Mínimo 1024" prefWidth="120" prefHeight="32"/>
                </HBox>

                <Button text="Aplicar Configuración" onAction="#handleApplyConfig" prefHeight="32" styleClass="button-primary"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="lblMessage" wrapText="true" styleClass="form-message"/>
            </HBox>

            <!-- SIMULACIÓN DEL SISTEMA DE ASOCIADOS -->
            <VBox fx:id="mainContainer" spacing="12" alignment="TOP_CENTER" visible="false" managed="false" VBox.vgrow="ALWAYS" maxWidth="Infinity">

                <!-- TARJETAS DE MÉTRICAS Y LEYENDA -->
                <HBox spacing="12" alignment="CENTER" maxWidth="Infinity">
                    <HBox spacing="8" alignment="CENTER" styleClass="card" HBox.hgrow="ALWAYS" prefHeight="42">
                        <Label text="TOTAL:" styleClass="muted"/>
                        <Label fx:id="lblTotal" text="1024 KB" styleClass="value"/>
                    </HBox>
                    <HBox spacing="8" alignment="CENTER" styleClass="card" HBox.hgrow="ALWAYS" prefHeight="42">
                        <Label text="USADA:" styleClass="muted"/>
                        <Label fx:id="lblUsed" text="0 KB" styleClass="value"/>
                    </HBox>
                    <HBox spacing="8" alignment="CENTER" styleClass="card" HBox.hgrow="ALWAYS" prefHeight="42">
                        <Label text="LIBRE:" styleClass="muted"/>
                        <Label fx:id="lblFree" text="1024 KB" styleClass="value"/>
                    </HBox>
                    <HBox spacing="8" alignment="CENTER" styleClass="card" HBox.hgrow="ALWAYS" prefHeight="42">
                        <Label text="SOBRANTE:" styleClass="muted"/>
                        <Label fx:id="lblWaste" text="0 KB" styleClass="value"/>
                    </HBox>

                    <!-- LEYENDA -->
                    <HBox spacing="16" alignment="CENTER" styleClass="card, compact-card" prefHeight="42" style="-fx-padding: 0 16;">
                        <HBox spacing="8" alignment="CENTER">
                            <Region minWidth="16" prefWidth="16" maxWidth="16" minHeight="16" prefHeight="16" maxHeight="16"
                                    style="-fx-background-color: #3b82f6; -fx-border-color: #1d4ed8; -fx-background-radius: 3; -fx-border-radius: 3;"/>
                            <Label text="Bloque Libre" styleClass="value"/>
                        </HBox>
                        <HBox spacing="8" alignment="CENTER">
                            <Region minWidth="16" prefWidth="16" maxWidth="16" minHeight="16" prefHeight="16" maxHeight="16"
                                    style="-fx-background-color: #22c55e; -fx-border-color: #15803d; -fx-background-radius: 3; -fx-border-radius: 3;"/>
                            <Label text="Bloque Ocupado" styleClass="value"/>
                        </HBox>
                    </HBox>
                </HBox>

                <!-- BARRA HORIZONTAL DE VISUALIZACIÓN DINÁMICA -->
                <VBox spacing="6" styleClass="card" maxWidth="Infinity">
                    <Label text="MAPA DE DIVISIONES EN MEMORIA (BUDDY SYSTEM)" styleClass="card-title"/>
                    <HBox fx:id="memoryBarContainer" prefHeight="60" minHeight="60" spacing="3" style="-fx-padding: 4; -fx-background-color: #0f172a; -fx-background-radius: 6;" maxWidth="Infinity"/>
                </VBox>

                <!-- SECCIÓN INFERIOR: FORMULARIO IZQUIERDA Y TABLA DERECHA -->
                <HBox spacing="14" maxWidth="Infinity" VBox.vgrow="ALWAYS">

                    <VBox spacing="10" styleClass="card" prefWidth="280" minWidth="260">
                        <Label text="NUEVO PROCESO" styleClass="card-title"/>

                        <VBox spacing="4">
                            <Label text="Nombre del Proceso" styleClass="muted"/>
                            <TextField fx:id="txtProcessName" promptText="Ej. DDD1" prefHeight="32"/>
                        </VBox>

                        <VBox spacing="4">
                            <Label text="Tamaño Requerido (KB)" styleClass="muted"/>
                            <TextField fx:id="txtProcessSize" promptText="Ej. 120" prefHeight="32"/>
                        </VBox>

                        <Region VBox.vgrow="ALWAYS"/>

                        <Button text="+ Asignar Proceso" onAction="#handleAddProcess" maxWidth="Infinity" prefHeight="36" styleClass="button-primary"/>
                        <Button text="↻ Reiniciar Sistema" onAction="#handleResetMemory" maxWidth="Infinity" prefHeight="32" styleClass="button-secondary"/>
                    </VBox>

                    <!-- TABLA DERECHA RESPONSIVA -->
                    <VBox spacing="10" styleClass="card" HBox.hgrow="ALWAYS">
                        <Label text="PROCESOS EN MEMORIA" styleClass="card-title"/>

                        <TableView fx:id="tblProcesses" VBox.vgrow="ALWAYS" prefHeight="180">
                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                            </columnResizePolicy>
                            <columns>
                                <TableColumn fx:id="colName" text="Proceso"/>
                                <TableColumn fx:id="colRequested" text="Solicitado"/>
                                <TableColumn fx:id="colBlockSize" text="Bloque Buddy"/>
                                <TableColumn fx:id="colRange" text="Rango Memoria"/>
                                <TableColumn fx:id="colWaste" text="Sobrante"/>
                                <TableColumn fx:id="colAction" text="Acción"/>
                            </columns>
                        </TableView>
                    </VBox>

                </HBox>

            </VBox>

        </VBox>
    </content>
</ScrollPane>