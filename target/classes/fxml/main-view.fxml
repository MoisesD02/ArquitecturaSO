<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.simuladorso.ui.MainController"
            styleClass="app-root">
    <top>
        <HBox alignment="CENTER_LEFT" spacing="18" styleClass="topbar">
            <padding><Insets top="16" right="24" bottom="16" left="24"/></padding>
            <VBox spacing="2" HBox.hgrow="ALWAYS">
                <Label text="simuladorSO" styleClass="app-title"/>
                <Label text="Núcleo base del simulador de Sistema Operativo" styleClass="app-subtitle"/>
            </VBox>
            <VBox alignment="CENTER_RIGHT" spacing="2">
                <Label text="KERNEL" styleClass="top-label"/>
                <Label fx:id="lblKernelStatus" text="Detenido" styleClass="status-off"/>
            </VBox>
        </HBox>
    </top>

    <left>
        <VBox prefWidth="220" spacing="12" styleClass="sidebar">
            <padding><Insets top="20" right="16" bottom="20" left="16"/></padding>

            <Label text="NAVEGACIÓN" styleClass="sidebar-caption"/>
            <VBox spacing="10">
                <Button fx:id="navDashboard" text="▦  Panel principal" onAction="#showDashboard" maxWidth="Infinity" styleClass="nav-button"/>
                <Button fx:id="navProcesses" text="⚙  Procesos" onAction="#showProcesses" maxWidth="Infinity" styleClass="nav-button"/>
                <Button fx:id="navMemory" text="≡  Memoria" onAction="#showMemory" maxWidth="Infinity" styleClass="nav-button"/>
                <Button fx:id="navDevices" text="⌁  Dispositivos E/S" onAction="#showDevices" maxWidth="Infinity" styleClass="nav-button"/>
                <Button fx:id="navFiles" text="▱  Sistema de archivos" onAction="#showFiles" maxWidth="Infinity" styleClass="nav-button"/>
                <Button fx:id="navLogs" text="☷  Log del sistema" onAction="#showLogs" maxWidth="Infinity" styleClass="nav-button"/>
            </VBox>

            <Region VBox.vgrow="ALWAYS"/>
            <Separator/>

            <!-- Controles con mayor separación entre sí para evitar clics accidentales -->
            <Label text="CONTROLES DEL NÚCLEO" styleClass="sidebar-caption"/>
            <VBox spacing="12">
                <Button text="▶  Iniciar SO" onAction="#handleStart" maxWidth="Infinity" styleClass="button-success"/>
                <Button text="■  Detener" onAction="#handleStop" maxWidth="Infinity" styleClass="button-danger"/>
                <Button text="▶|  Avanzar reloj" onAction="#handleAdvanceClock" maxWidth="Infinity" styleClass="button-secondary"/>
                <Button text="↻  Reiniciar" onAction="#handleRestart" maxWidth="Infinity" styleClass="button-primary"/>
            </VBox>
        </VBox>
    </left>

    <center>
        <StackPane styleClass="content-area">
            <padding><Insets top="24" right="24" bottom="24" left="24"/></padding>

            <VBox fx:id="dashboardPage" spacing="18">
                <VBox spacing="3">
                    <Label text="Panel principal" styleClass="page-title"/>
                    <Label text="Estado general de los componentes fundamentales del simulador." styleClass="page-subtitle"/>
                </VBox>

                <!-- Cuadrícula 3x3 exacta -->
                <GridPane hgap="16" vgap="16" VBox.vgrow="ALWAYS">
                    <columnConstraints>
                        <ColumnConstraints percentWidth="33.33" hgrow="ALWAYS"/>
                        <ColumnConstraints percentWidth="33.33" hgrow="ALWAYS"/>
                        <ColumnConstraints percentWidth="33.33" hgrow="ALWAYS"/>
                    </columnConstraints>
                    <rowConstraints>
                        <RowConstraints percentHeight="33.33" vgrow="ALWAYS"/>
                        <RowConstraints percentHeight="33.33" vgrow="ALWAYS"/>
                        <RowConstraints percentHeight="33.33" vgrow="ALWAYS"/>
                    </rowConstraints>

                    <!-- (1,1): RELOJ DEL SISTEMA -->
                    <VBox GridPane.columnIndex="0" GridPane.rowIndex="0" spacing="10" styleClass="dashboard-card">
                        <Label text="RELOJ DEL SISTEMA" styleClass="card-title"/>
                        <Region VBox.vgrow="ALWAYS"/>
                        <VBox alignment="CENTER" spacing="4">
                            <Label text="Hora actual" styleClass="muted"/>
                            <Label fx:id="lblRealTime" text="00:00:00" styleClass="real-time-clock"/>

                            <Region minHeight="12"/>

                            <Label fx:id="lblClock" text="00:00:00" styleClass="clock-large"/>
                            <Label text="Tiempo transcurrido" styleClass="muted"/>
                        </VBox>
                        <Region VBox.vgrow="ALWAYS"/>
                    </VBox>

                    <!-- (1,2): DISPOSITIVOS DE E/S -->
                    <VBox GridPane.columnIndex="1" GridPane.rowIndex="0" onMouseClicked="#showDevices" spacing="9" styleClass="dashboard-card">
                        <Label text="DISPOSITIVOS E/S" styleClass="card-title"/>
                        <Label text="● Teclado      Disponible" styleClass="device-on"/>
                        <Label text="● Mouse         Disponible" styleClass="device-on"/>
                        <Label text="● Disco          Disponible" styleClass="device-on"/>
                        <Label text="● Impresora    Desconectada" styleClass="device-off"/>
                        <Region VBox.vgrow="ALWAYS"/>
                        <Label text="Detección simulada." wrapText="true" styleClass="note"/>
                    </VBox>

                    <!-- (2,1): MEMORIA -->
                    <VBox GridPane.columnIndex="0" GridPane.rowIndex="1" onMouseClicked="#showMemory" spacing="10" styleClass="dashboard-card">
                        <Label text="MEMORIA" styleClass="card-title"/>
                        <GridPane hgap="10" vgap="4">
                            <Label text="Total" GridPane.rowIndex="0" GridPane.columnIndex="0" styleClass="muted"/>
                            <Label fx:id="lblMemoryTotal" text="4096 MB" GridPane.rowIndex="0" GridPane.columnIndex="1" styleClass="value"/>
                            <Label text="Usada" GridPane.rowIndex="1" GridPane.columnIndex="0" styleClass="muted"/>
                            <Label fx:id="lblMemoryUsed" text="0 MB" GridPane.rowIndex="1" GridPane.columnIndex="1" styleClass="value"/>
                            <Label text="Disponible" GridPane.rowIndex="2" GridPane.columnIndex="0" styleClass="muted"/>
                            <Label fx:id="lblMemoryAvailable" text="4096 MB" GridPane.rowIndex="2" GridPane.columnIndex="1" styleClass="value"/>
                        </GridPane>
                        <ProgressBar fx:id="memoryProgress" progress="0" maxWidth="Infinity"/>
                    </VBox>

                    <!-- (2,2): CPU -->
                    <VBox GridPane.columnIndex="1" GridPane.rowIndex="1" spacing="10" styleClass="dashboard-card">
                        <Label text="CPU" styleClass="card-title"/>
                        <HBox spacing="8"><Label text="Estado:" styleClass="muted"/><Label fx:id="lblCpuStatus" text="Detenida" styleClass="value"/></HBox>
                        <Label text="Proceso actual: Ninguno" styleClass="muted"/>
                        <Label text="Uso: 0%" styleClass="muted"/>
                        <ProgressBar progress="0" maxWidth="Infinity"/>
                    </VBox>

                    <!-- (3,1): PROCESOS -->
                    <VBox GridPane.columnIndex="0" GridPane.rowIndex="2" onMouseClicked="#showProcesses" spacing="10" styleClass="dashboard-card">
                        <Label text="PROCESOS" styleClass="card-title"/>
                        <Label text="0" styleClass="metric"/>
                        <Label text="procesos activos" styleClass="muted"/>
                        <Region VBox.vgrow="ALWAYS"/>
                        <Label text="Gestor preparado." wrapText="true" styleClass="note"/>
                    </VBox>

                    <!-- (3,2): SISTEMA DE ARCHIVOS -->
                    <VBox GridPane.columnIndex="1" GridPane.rowIndex="2" onMouseClicked="#showFiles" spacing="9" styleClass="dashboard-card">
                        <Label text="SISTEMA DE ARCHIVOS" styleClass="card-title"/>
                        <VBox spacing="2">
                            <Label text="▱  /" styleClass="file-line"/>
                            <Label text="    ├─ home" styleClass="file-line"/>
                            <Label text="    ├─ system" styleClass="file-line"/>
                            <Label text="    └─ temp" styleClass="file-line"/>
                        </VBox>
                        <Region VBox.vgrow="ALWAYS"/>
                        <Label text="Estructura base montada." styleClass="note"/>
                    </VBox>

                    <!-- (1,3 - 3,3): LOG DEL SISTEMA -->
                    <VBox GridPane.columnIndex="2" GridPane.rowIndex="0" GridPane.rowSpan="3" onMouseClicked="#showLogs" spacing="8" styleClass="card log-card interactive-card">
                        <HBox alignment="CENTER_LEFT">
                            <Label text="LOG DEL SISTEMA" styleClass="card-title" HBox.hgrow="ALWAYS"/>
                            <Button text="Ver completo" onAction="#showLogs" styleClass="small-button"/>
                        </HBox>
                        <TextArea fx:id="dashboardLog" editable="false" wrapText="true" VBox.vgrow="ALWAYS" styleClass="log-area"/>
                    </VBox>
                </GridPane>
            </VBox>

            <!-- PÁGINAS SECUNDARIAS SIN CAMBIOS -->
            <VBox fx:id="processesPage" visible="false" managed="false" spacing="18">
                <Label text="Procesos" styleClass="page-title"/>
                <VBox spacing="12" styleClass="card wide-card">
                    <Label text="Clase Proceso" styleClass="card-title"/>
                    <Label text="El núcleo base ya contempla la representación de un proceso mediante PID, nombre, estado y memoria. La creación, planificación y cambio de estados se implementarán en los siguientes avances." wrapText="true" styleClass="body-text"/>
                    <Separator/>
                    <Label text="Estado actual: 0 procesos activos" styleClass="value"/>
                </VBox>
            </VBox>

            <VBox fx:id="memoryPage" visible="false" managed="false" spacing="18">
                <Label text="Memoria" styleClass="page-title"/>
                <VBox spacing="12" styleClass="card wide-card">
                    <Label text="Memoria principal simulada" styleClass="card-title"/>
                    <Label text="Capacidad total: 4096 MB" styleClass="value"/>
                    <Label text="En este avance se modela el componente y se muestra su estado. La asignación y liberación por procesos se añadirá posteriormente." wrapText="true" styleClass="body-text"/>
                </VBox>
            </VBox>

            <VBox fx:id="devicesPage" visible="false" managed="false" spacing="18">
                <Label text="Dispositivos de E/S" styleClass="page-title"/>
                <VBox spacing="10" styleClass="card wide-card">
                    <Label text="Dispositivos reconocidos por el núcleo" styleClass="card-title"/>
                    <Label text="● Teclado — Entrada — Disponible" styleClass="device-on"/>
                    <Label text="● Mouse — Entrada — Disponible" styleClass="device-on"/>
                    <Label text="● Disco — Almacenamiento — Disponible" styleClass="device-on"/>
                    <Label text="● Impresora — Salida — Desconectada" styleClass="device-off"/>
                    <Label text="La gestión de interrupciones y operaciones de E/S se reserva para avances posteriores." wrapText="true" styleClass="note"/>
                </VBox>
            </VBox>

            <VBox fx:id="filesPage" visible="false" managed="false" spacing="18">
                <Label text="Sistema de archivos" styleClass="page-title"/>
                <VBox spacing="10" styleClass="card wide-card">
                    <Label text="Estructura inicial" styleClass="card-title"/>
                    <Label text="/\n├── home\n├── system\n└── temp" styleClass="file-tree-static"/>
                    <Label text="En el núcleo base se representa la estructura; las operaciones de crear, eliminar y administrar archivos se incorporarán posteriormente." wrapText="true" styleClass="note"/>
                </VBox>
            </VBox>

            <VBox fx:id="logsPage" visible="false" managed="false" spacing="18">
                <Label text="Log del sistema" styleClass="page-title"/>
                <Label text="Registro cronológico de los eventos generados por el núcleo base." styleClass="page-subtitle"/>
                <TextArea fx:id="fullLog" editable="false" wrapText="true" VBox.vgrow="ALWAYS" styleClass="log-area full-log"/>
            </VBox>
        </StackPane>
    </center>
</BorderPane>